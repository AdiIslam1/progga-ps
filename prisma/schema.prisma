generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Admin {
  id       String @id
  username String @unique
  password String
}

model Student {
  id               String          @id
  studentId        Int             @unique
  password         String
  name             String
  surname          String
  phone            String?         @unique
  address          String
  img              String?
  bloodType        String
  sex              UserSex
  createdAt        DateTime        @default(now())
  guardianName     String?
  guardianPhone    String?
  classId          Int
  class            Class           @relation(fields: [classId], references: [id], onDelete: Cascade)
  attendances      Attendance[]
  results          Result[]
  customTuitionFee Float?
  feeCollections   FeeCollection[]
  reportCards      ReportCard[]
  birthday         DateTime
}

model Teacher {
  id        String    @id
  username  String    @unique
  password  String
  name      String
  surname   String
  email     String?   @unique
  phone     String?   @unique
  address   String
  img       String?
  bloodType String
  sex       UserSex
  createdAt DateTime  @default(now())
  subjects  Subject[]
  lessons   Lesson[]
  classes   Class[]
  birthday  DateTime
}


model Class {
  id       Int    @id @default(autoincrement())
  name     String @unique  // numeric string: "1", "2", ... "6"
  capacity Int

  supervisorId  String?
  supervisor    Teacher?       @relation(fields: [supervisorId], references: [id])
  lessons       Lesson[]
  students      Student[]
  events        Event[]
  announcements Announcement[]
  feePackages   FeePackage[]
  notices       Notice[]
  subjects      Subject[]
}

model Subject {
  id            Int            @id @default(autoincrement())
  name          String
  classId       Int
  class         Class          @relation(fields: [classId], references: [id], onDelete: Cascade)
  teachers      Teacher[]
  lessons       Lesson[]
  examSchedules ExamSchedule[]
  results       Result[]
  attendances   Attendance[]

  @@unique([name, classId])
}

model Lesson {
  id        Int      @id @default(autoincrement())
  name      String
  day       Day
  startTime DateTime
  endTime   DateTime

  subjectId   Int
  subject     Subject      @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  classId     Int
  class       Class        @relation(fields: [classId], references: [id], onDelete: Cascade)
  teacherId   String
  teacher     Teacher      @relation(fields: [teacherId], references: [id], onDelete: Cascade)
}

model Exam {
  id            Int            @id @default(autoincrement())
  title         String
  results       Result[]
  examSchedules ExamSchedule[]
}

model Result {
  id        Int      @id @default(autoincrement())
  score     Int
  gpa       Float?   @default(0.0)
  grade     String?  @default("F")

  examId    Int?
  exam      Exam?    @relation(fields: [examId], references: [id], onDelete: Cascade)
  subjectId Int?
  subject   Subject? @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  studentId String
  student   Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
}

model Attendance {
  id      Int      @id @default(autoincrement())
  date    DateTime
  present Boolean

  studentId String
  student   Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
  subjectId Int
  subject   Subject @relation(fields: [subjectId], references: [id], onDelete: Cascade)
}

model Event {
  id          Int      @id @default(autoincrement())
  title       String
  description String
  startTime   DateTime
  endTime     DateTime

  classId Int?
  class   Class? @relation(fields: [classId], references: [id], onDelete: Cascade)
}

model Announcement {
  id          Int      @id @default(autoincrement())
  title       String
  description String
  date        DateTime

  classId Int?
  class   Class? @relation(fields: [classId], references: [id], onDelete: Cascade)
}

model FeePackage {
  id          Int             @id @default(autoincrement())
  name        String
  description String?
  amount      Float
  type        FeePackageType  @default(OTHER_FEE)
  classId     Int?
  class       Class?          @relation(fields: [classId], references: [id], onDelete: Cascade)
  collections FeeCollection[]
}

model FeeCollection {
  id           Int         @id @default(autoincrement())
  studentId    String
  student      Student     @relation(fields: [studentId], references: [id], onDelete: Cascade)
  feePackageId Int?
  feePackage   FeePackage? @relation(fields: [feePackageId], references: [id], onDelete: Cascade)
  name         String
  amount       Float
  month        String?     // e.g. "2026-01"
  status       FeeStatus   @default(UNPAID)
  paidAmount   Float       @default(0)
  paidAt       DateTime?
  receiptNo    String?
  receivedById String?
}

model Expense {
  id       Int      @id @default(autoincrement())
  title    String
  amount   Float
  date     DateTime @default(now())
  category String
}

model Notice {
  id             Int        @id @default(autoincrement())
  title          String
  content        String
  date           DateTime   @default(now())
  type           NoticeType @default(SMS)
  recipientId    String?
  classId        Int?
  class          Class?     @relation(fields: [classId], references: [id], onDelete: Cascade)
  recipientCount Int        @default(0)
  sentCount      Int        @default(0)
  status         String     @default("PENDING")
}

model ExamSchedule {
  id        Int      @id @default(autoincrement())
  examId    Int
  exam      Exam     @relation(fields: [examId], references: [id], onDelete: Cascade)
  subjectId Int
  subject   Subject  @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  date      DateTime
  startTime DateTime
  endTime   DateTime
  room      String?
}

model ReportCard {
  id        Int      @id @default(autoincrement())
  studentId String
  student   Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  term      String
  gpa       Float
  grade     String
  year      Int
  createdAt DateTime @default(now())
}

model SmsConfig {
  id       Int    @id @default(autoincrement())
  apiUrl   String
  apiKey   String
  senderId String
}

enum UserSex {
  MALE
  FEMALE
}

enum Day {
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
  SAT
}

enum FeePackageType {
  TUITION
  OTHER_FEE
}

enum FeeStatus {
  PAID
  UNPAID
  PENDING
}

enum NoticeType {
  SMS
  EMAIL
  SYSTEM
}
